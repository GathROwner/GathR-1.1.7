{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "SUPPRESS_XCODE_OUTPUT": "false",
        "EXPO_PUBLIC_SOCIAL_FEATURE_ENABLED": "true",
        "EXPO_PUBLIC_SOCIAL_RELEASE_TWO_ENABLED": "true",
        "EXPO_PUBLIC_USE_FIREBASE_EMULATORS": "true",
        "EXPO_PUBLIC_FIREBASE_EMULATOR_HOST": "10.0.2.2"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk",
        "resourceClass": "default"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_SOCIAL_FEATURE_ENABLED": "true",
        "EXPO_PUBLIC_SOCIAL_RELEASE_TWO_ENABLED": "true",
        "EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG": "true",
        "EXPO_PUBLIC_USE_FIREBASE_EMULATORS": "false",
        "EXPO_PUBLIC_FIREBASE_TARGET": "staging",
        "GOOGLE_SERVICES_JSON": "./google-services.staging.json"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk",
        "resourceClass": "default"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_SOCIAL_FEATURE_ENABLED": "true",
        "EXPO_PUBLIC_USE_FIREBASE_EMULATORS": "false"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "C:/Users/craig/.gathr/credentials/google-play-release-uploader.json",
        "track": "production",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      },
      "ios": {
        "ascAppId": "6743016252"
      }
    }
  }
}
